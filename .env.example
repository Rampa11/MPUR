DATABASE_URL=
PORT=3000
# Docker host port and bind address. Keep loopback when using a local reverse proxy.
APP_PORT=3000
BIND_ADDRESS=127.0.0.1
# Admin review (required to approve submissions). Choose private, unique values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# At least 32 random characters; changing this signs all admins out.
SESSION_SECRET=
